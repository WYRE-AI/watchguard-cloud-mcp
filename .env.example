# WatchGuard Cloud API credentials, from Account Settings > API Access.
# AccessID/Password are a read-write API credential pair exchanged for a
# short-lived OAuth access token; WatchGuard-API-Key is a separate,
# independently-issued key generated in the same flow.
WATCHGUARDCLOUD_ACCESS_ID=
WATCHGUARDCLOUD_PASSWORD=
WATCHGUARDCLOUD_API_KEY=
# Optional: usa (default), deu (EMEA), or jpn (APAC) - see your account's
# data-storage region on the Managed Access page in WatchGuard Cloud.
WATCHGUARDCLOUD_REGION=usa
